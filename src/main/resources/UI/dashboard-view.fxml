<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="UI.DashboardController">
  <top>
    <!-- Custom title bar - just because it looks better -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" onMouseDragged="#onTitleBarDragged"
      onMousePressed="#onTitleBarPressed" prefHeight="36.0" styleClass="title-bar">
      <padding>
        <Insets left="14.0" right="6.0"/>
      </padding>
      <Label styleClass="title-bar-label" text="Otter Do Better"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="sessionLabel" styleClass="title-bar-session-label" text="Not logged in"/>
      <Button onAction="#onMinimizeClick" styleClass="title-bar-button" text="_"/>
      <Button onAction="#onCloseClick" styleClass="title-bar-button" text="X"/>
    </HBox>
  </top>
  <center>
    <StackPane>
      <children>
        <VBox alignment="CENTER" maxWidth="480.0" spacing="22.0" styleClass="card">
          <children>
            <Text fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-title" text="Dashboard">
              <font>
                <Font size="26.0"/>
              </font>
            </Text>

            <HBox alignment="CENTER" spacing="12.0">
              <Button fx:id="takeQuizButton" mnemonicParsing="false" onMouseClicked="#onTakeQuizClick"
                styleClass="btn-primary" text="Take a Quiz"/>

              <Button onMouseClicked="#onQuestionBankClick"
                      styleClass="btn-primary"
                      text="Question Bank"/>

              <Button fx:id="manageAccountsButton" mnemonicParsing="false"
                onMouseClicked="#onManageAccountsClick" styleClass="btn-secondary" text="Account Manager"/>
            </HBox>

            <Label fx:id="statusText" styleClass="page-subtitle" textAlignment="CENTER" wrapText="true"/>

            <Button onMouseClicked="#onQuizClick" styleClass="btn-secondary" text="Start Quiz"/>
            <Button fx:id="logout" mnemonicParsing="false" onMouseClicked="#onLogoutClick"
              styleClass="btn-link" text="Log Out"/>
          </children>
        </VBox>
      </children>
    </StackPane>
  </center>
</BorderPane>
