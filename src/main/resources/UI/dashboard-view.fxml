<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="UI.DashboardController">
  <top>
    <!-- Custom title bar - just because it looks better -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" onMouseDragged="#onTitleBarDragged"
      onMousePressed="#onTitleBarPressed" prefHeight="32.0" style="-fx-background-color: #0b49b4;">
      <padding>
        <Insets left="10.0" right="10.0"/>
      </padding>
      <Label text="Otter Do Better" textFill="WHITE"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="sessionLabel" text="Not logged in" textFill="WHITE"
        style="-fx-font-size: 11px; -fx-padding: 0 10 0 0;"/>
      <Button onAction="#onMinimizeClick"
        style="-fx-background-color: transparent; -fx-text-fill: white;" text="_"/>
      <Button onAction="#onCloseClick"
        style="-fx-background-color: transparent; -fx-text-fill: white;" text="X"/>
    </HBox>
  </top>
  <center>
    <VBox alignment="CENTER" spacing="18.0" BorderPane.alignment="CENTER">
      <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
      </padding>
      <Text fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" text="Dashboard">
        <font>
          <Font size="24.0"/>
        </font>
      </Text>

      <HBox alignment="CENTER" spacing="12.0">
        <Button fx:id="takeQuizButton" mnemonicParsing="false" onMouseClicked="#onTakeQuizClick"
          text="Take a Quiz"/>
        <Button fx:id="manageAccountsButton" mnemonicParsing="false"
          onMouseClicked="#onManageAccountsClick" text="Account Manager"/>
      </HBox>

      <Label fx:id="statusText" textAlignment="CENTER" wrapText="true"/>

      <Button fx:id="logout" mnemonicParsing="false" onMouseClicked="#onLogoutClick"
        text="Log Out"/>
    </VBox>
  </center>
</BorderPane>
