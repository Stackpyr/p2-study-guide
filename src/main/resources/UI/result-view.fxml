<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="UI.ResultController">

    <top>
        <!-- Custom title bar -->
        <HBox fx:id="titleBar"
              alignment="CENTER_LEFT"
              onMouseDragged="#onTitleBarDragged"
              onMousePressed="#onTitleBarPressed"
              prefHeight="32.0"
              style="-fx-background-color: #0b49b4;">
            <padding>
                <Insets left="10.0" right="10.0" />
            </padding>

            <children>
                <Label text="Otter Do Better"
                       textFill="WHITE" />

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="sessionLabel"
                       text="Not logged in"
                       textFill="WHITE"
                       style="-fx-font-size: 11px;
                      -fx-padding: 0 10 0 0;" />

                <Button onAction="#onMinimizeClick"
                        style="-fx-background-color: transparent;
                       -fx-text-fill: white;"
                        text="_" />

                <Button onAction="#onCloseClick"
                        style="-fx-background-color: transparent;
                       -fx-text-fill: white;"
                        text="X" />
            </children>
        </HBox>
    </top>

    <center>
        <!-- Displays the final quiz result -->
        <VBox alignment="CENTER"
              spacing="20.0"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="40.0"
                        left="40.0"
                        right="40.0"
                        top="40.0" />
            </padding>

            <children>
                <Text fill="#0b49b4"
                      strokeType="OUTSIDE"
                      strokeWidth="0.0"
                      text="Quiz Results">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>

                <Label fx:id="scoreLabel"
                       text="Score: 0 out of 0"
                       style="-fx-font-size: 18px;
                      -fx-font-weight: bold;" />

                <Label fx:id="percentageLabel"
                       text="Percentage: 0.0%"
                       style="-fx-font-size: 16px;" />

                <Label fx:id="messageLabel"
                       text="Quiz complete."
                       wrapText="true" />

                <Button onAction="#onBackClick"
                        text="Back to Dashboard" />
            </children>
        </VBox>
    </center>
</BorderPane>