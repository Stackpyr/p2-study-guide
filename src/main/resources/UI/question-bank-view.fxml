<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.QuestionBankController">
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="36.0" styleClass="title-bar">
            <padding>
                <Insets left="14.0" right="6.0" />
            </padding>
            <Label text="Otter Do Better" textFill="WHITE" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="sessionLabel" style="-fx-font-size: 11px; -fx-padding: 0 10 0 0;" text="Not logged in" textFill="WHITE" />
            <Button onAction="#onMinimizeClick" style="-fx-background-color: transparent; -fx-text-fill: white;" text="_" />
            <Button onAction="#onCloseClick" style="-fx-background-color: transparent; -fx-text-fill: white;" text="X" />
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Text id="lblTitle" fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-title" text="Question Bank">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>

                <TableView VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
    <center>
        <VBox alignment="CENTER" spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <Text fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" text="Question Bank">
                <font>
                    <Font size="24.0" />
                </font>
            </Text>

            <HBox alignment="CENTER" spacing="10.0">
                <Label text="Search:" />
                <TextField fx:id="searchQuestionsField" prefWidth="250.0" promptText="Search questions..." />

                <Label text="Category:" />
                <ComboBox fx:id="categoryChoiceBox" prefWidth="200.0" />
            </HBox>

            <Label fx:id="noMatchesLabel"
                   text="No matches found"
                   style="-fx-text-fill: red;"
                   visible="false"
                   />

            <TableView fx:id="questionTable" prefHeight="350.0" prefWidth="350.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="questionColumn" prefWidth="400.0" text="Question" />
                    <TableColumn fx:id="categoryColumn" prefWidth="168.0" text="Category" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="20.0">
                <Button onAction="#onAddQuestionClicked" text="Add Question" />
                <Button fx:id="logout" mnemonicParsing="false" onMouseClicked="#onLogoutClick" text="Log Out" />
            </HBox>
        </VBox>
    </center>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Text id="lblTitle" fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-title" text="Question Bank">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>

                <TableView VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
</BorderPane>
