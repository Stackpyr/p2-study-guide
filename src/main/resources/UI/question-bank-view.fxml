<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="UI.QuestionBankController"
        prefHeight="600.0"
        prefWidth="900.0"
        stylesheets="@app.css">

    <top>
        <VBox>
            <children>
                <HBox
                        fx:id="titleBar"
                        alignment="CENTER_LEFT"
                        prefHeight="36.0"
                        styleClass="title-bar">

                    <padding>
                        <Insets left="14.0" right="6.0" />
                    </padding>

                    <Label styleClass="title-bar-label"
                            text="Otter Do Better"/>

                    <Region HBox.hgrow="ALWAYS" />

                    <Label fx:id="sessionLabel"
                           styleClass="title-bar-session-label"
                           text="Not logged in"/>

                    <Button onAction="#onMinimizeClick"
                            styleClass="title-bar-button"
                            text="_"/>
                    <Button onAction="#onCloseClick"
                            styleClass="title-bar-button"
                            text="X"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar-strip">
                    <padding>
                        <Insets bottom="14.0" left="20.0" right="20.0" top="14.0"/>
                    </padding>
                    <children>
                        <TextField fx:id="searchQuestionsField" promptText="Search questions..." HBox.hgrow="ALWAYS"/>

                        <Label styleClass="field-label"
                               text="Category: "/>

                        <ComboBox fx:id="categoryChoiceBox" prefWidth="220.0"/>

                        <Button onAction="#onBackClick"
                                styleClass="btn-secondary"
                                text="Back to Dashboard"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane">
            <content>
                <VBox spacing="14.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>

                    <children>

                        <Text styleClass="page-title" text="Question Bank"/>

                        <Label styleClass="page-subtitle"
                               text="Search and filter questions."/>

                        <Label fx:id="noMatchesLabel"
                               styleClass="error-label"
                               text="No matches found"
                               visible="false"/>

                        <Label fx:id="statusLabel"
                               styleClass="page-subtitle"
                               wrapText="true"/>

                        <TableView fx:id="questionTable" prefHeight="400.0" VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="questionColumn"
                                             prefWidth="380.0"
                                             text="Question"/>

                                <TableColumn fx:id="categoryColumn"
                                             prefWidth="180.0"
                                             text="Category"/>

                                <TableColumn fx:id="actionsColumn"
                                             prefWidth="90.0"
                                             text="Actions"/>

                            </columns>

                        </TableView>

                        <HBox alignment="CENTER" spacing="12.0">

                            <Button onAction="#onAddQuestionClicked"
                                    styleClass="btn-primary"
                                    text="Add Question"/>

                            <Button fx:id="logout"
                                    mnemonicParsing="false"
                                    onMouseClicked="#onLogoutClick"
                                    styleClass="btn-link"
                                    text="Log Out"/>

                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>