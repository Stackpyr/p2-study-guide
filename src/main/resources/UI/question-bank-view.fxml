<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="UI.QuestionBankController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="36.0" styleClass="title-bar">
            <padding>
                <Insets left="14.0" right="6.0" />
            </padding>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Text id="lblTitle" fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="page-title" text="Question Bank">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>

                <TableView VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
</BorderPane>
