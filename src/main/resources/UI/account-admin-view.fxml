<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="UI.AccountAdminController" prefHeight="520.0" prefWidth="760.0">
  <top>
    <VBox>
      <children>
        <!-- Custom title bar - matches the other scenes -->
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" onMouseDragged="#onTitleBarDragged"
          onMousePressed="#onTitleBarPressed" prefHeight="32.0" style="-fx-background-color: #0b49b4;">
          <padding>
            <Insets left="10.0" right="10.0"/>
          </padding>
          <children>
            <Label text="Otter Do Better" textFill="WHITE"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="sessionLabel" text="Not logged in" textFill="WHITE"
              style="-fx-font-size: 11px; -fx-padding: 0 10 0 0;"/>
            <Button onAction="#onMinimizeClick"
              style="-fx-background-color: transparent; -fx-text-fill: white;" text="_"/>
            <Button onAction="#onCloseClick"
              style="-fx-background-color: transparent; -fx-text-fill: white;" text="X"/>
          </children>
        </HBox>

        <!-- Search bar -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f2f2f2;">
          <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0"/>
          </padding>
          <children>
            <TextField fx:id="searchField" promptText="Search by username, email, or display name"
              HBox.hgrow="ALWAYS"/>
            <Button onAction="#onBackClick" text="Back to Dashboard"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </top>

  <center>
    <VBox spacing="12.0" BorderPane.alignment="CENTER">
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
      </padding>
      <children>
        <Text fill="#0b49b4" strokeType="OUTSIDE" strokeWidth="0.0" text="Account Administration">
          <font>
            <Font size="24.0"/>
          </font>
        </Text>

        <TableView fx:id="accountsTable" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="usernameColumn" prefWidth="120.0" text="Username"/>
            <TableColumn fx:id="emailColumn" prefWidth="160.0" text="Email"/>
            <TableColumn fx:id="displayNameColumn" prefWidth="120.0" text="Display Name"/>
            <TableColumn fx:id="activeColumn" prefWidth="80.0" text="Status"/>
            <TableColumn fx:id="adminColumn" prefWidth="70.0" text="Role"/>
            <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions"/>
          </columns>
        </TableView>

        <Label fx:id="statusLabel" wrapText="true"/>
      </children>
    </VBox>
  </center>
</BorderPane>
