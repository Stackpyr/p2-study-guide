<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example</groupId>
  <artifactId>OtterDoBetter</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>OtterDoBetter</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.12.1</junit.version>
    <javafx.version>21.0.6</javafx.version>
  </properties>

  <!-- Root cause (confirmed by reading the actual published POMs on Central):
       every org.openjfx:javafx-* artifact's own POM declares a dependency on
       ITSELF with <classifier>${javafx.platform}</classifier> (e.g.
       javafx-controls depends on javafx-controls:${javafx.platform}, plus
       javafx-graphics with no classifier, which in turn self-references
       too, cascading down through javafx-base). Maven reads that shared POM
       for dependency metadata regardless of which classifier WE request
       directly, so this unresolved self-reference gets pulled in no matter
       what our own <classifier> says. javafx.platform is meant to come from
       JavaFX's own parent POM profiles keyed on the *default* Maven <os>
       activation, which has no case for windows+aarch64 (or any other
       non-standard combo), so it never resolves there either.
       Fix: declare all four modules directly ourselves (below, with a
       literal classifier, no property indirection) AND exclude every
       org.openjfx artifact from each one's transitive closure, so Maven
       never has to chase that broken self-reference at all. -->
  <profiles>
    <!-- JavaFX does not publish windows-aarch_64 natives, so ARM Windows
         falls back to the win (x86_64) jars, which run fine under Windows'
         built-in x64 emulation. -->
    <profile>
      <id>windows</id>
      <activation>
        <os><family>windows</family></os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
          <classifier>win</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>mac-x86_64</id>
      <activation>
        <os><family>mac</family><arch>x86_64</arch></os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>mac-aarch64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
          <classifier>mac-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-x86_64</id>
      <activation>
        <os><family>unix</family><name>linux</name><arch>amd64</arch></os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>linux-aarch64</id>
      <activation>
        <os><family>unix</family><name>linux</name><arch>aarch64</arch></os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-fxml</artifactId>
          <version>${javafx.version}</version>
          <classifier>linux-aarch64</classifier>
          <exclusions>
            <exclusion>
              <groupId>org.openjfx</groupId>
              <artifactId>*</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <!-- provided (not test) scope so module-info.java's "requires static"
           can resolve it during the main compile too, without bundling it
           into the packaged app or conflicting with the test classpath -->
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.50.3.0</version>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- Our module-info.java makes this a named module, which makes
               surefire try to run tests on the module path. That splits
               junit-platform-launcher (unnamed module) from
               junit-platform-commons (a real named module) across the
               module boundary and JPMS blocks the cross-access. Running
               tests on the plain classpath instead avoids that split. -->
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>UI.OtterDoBetterApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>